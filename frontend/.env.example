# Leave unset during local dev — Vite's dev-server proxy (vite.config.ts)
# forwards /api and /ws to http://localhost:8000 for you.
#
# Set these when the frontend is deployed separately from the API
# (e.g. served as a static build without a same-origin reverse proxy):
# VITE_API_BASE_URL=https://api.example.com
# VITE_WS_URL=wss://api.example.com/ws/tasks

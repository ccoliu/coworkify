    },
    "views": [
      {
        "id": "run-path",
        "label": "建立與執行一次 run",
        "focus": [
          "frontend",
          "api",
          "db",
          "redis",
          "worker"
        ],
        "note": "使用者在畫布上建立 workflow 定義並執行；API 把 run 與 task 寫進 PostgreSQL，派送根節點到 Redis，Worker 執行後由 executor 組好下游的 inputs 再派送。"
      },
      {
        "id": "agent-path",
        "label": "LLM 步驟",
        "focus": [
          "redis",
          "worker_agent",
          "llm",
          "db"
        ],
        "note": "agent_step 走專屬的 agent_step 佇列，只有裝了 Codoctopus 的 worker-agent 會消費；模型透過 OpenAI 相容 API 呼叫本機 LM Studio，以 structured output 回傳固定欄位。"
      },
      {
        "id": "realtime-push",
        "label": "即時狀態推播",
        "focus": [
          "worker",
          "redis",
          "api",
          "frontend"
        ],
        "note": "Worker 透過 Redis Pub/Sub 發布狀態變更，API 訂閱後以 WebSocket 推給前端，畫布節點即時上色，無需輪詢。"
      },
      {
        "id": "auth-and-limit",
        "label": "身份驗證與限流",
        "focus": [
          "frontend",
          "api",
          "auth",
          "redis"
        ],
        "note": "所有 /tasks、/definitions、/workflows、/schedules 端點都需要 JWT，並依登入身份套用 Redis 滑動窗口限流。"
      },
      {
        "id": "cron-scheduling",
        "label": "週期性排程",
        "focus": [
          "beat",
          "redis",
          "worker",
          "db",
          "external"
        ],
        "note": "Celery Beat 每 60 秒檢查到期的排程，依定義當下的內容建立新的 run——例如每小時抓 GitHub issue、交給 LLM 分級、推到 Discord 的那條流水線。"
      }
    ]
  },

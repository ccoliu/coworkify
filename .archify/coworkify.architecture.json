  "cards": [
    {
      "dot": "emerald",
      "title": "執行模型",
      "items": [
        "定義與 run 分離：run 保留步驟快照與版本號，可 /rerun 重跑、/retry 從失敗點續跑",
        "8 種任務類型；python / shell 在受限 subprocess 執行，上游資料以 inputs 傳入",
        "for_each 展開、reduce_of 依項目順序收斂，分支未命中標記 cancelled"
      ]
    },
    {
      "dot": "violet",
      "title": "LLM 與排程",
      "items": [
        "agent_step 走獨立佇列，只有 worker-agent 裝 Codoctopus，以 structured output 回傳固定欄位",
        "Celery Beat 每 60 秒檢查 cron 排程；Redis Pub/Sub + WebSocket 即時推播狀態"
      ]
    },
    {
      "dot": "rose",
      "title": "安全與驗證",
      "items": [
        "bcrypt + JWT；Redis 滑動窗口限流依登入身份計算",
        "http_request / fetch_page 擋內網與 metadata 目標，轉址逐跳重驗",
        "executor 整合測試跑在真的 Postgres 上；Locust 壓測 API"
      ]
    }
  ]

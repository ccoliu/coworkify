    },
    "views": [
      {
        "id": "run-path",
        "label": "建立與執行一次 run",
        "focus": [
          "frontend",
          "api",
          "db",
          "redis",
          "worker"
        ],
        "note": "API 把 run 與 task 寫進 PostgreSQL、派送根節點到 Redis；Worker 執行後組好下游的 inputs 再派送，狀態經 Pub/Sub 與 WebSocket 即時推給畫布。"
      },
      {
        "id": "agent-path",
        "label": "LLM 步驟",
        "focus": [
          "redis",
          "worker_agent",
          "llm",
          "db"
        ],
        "note": "agent_step 走專屬的 agent_step 佇列，只有裝了 Codoctopus 的 worker-agent 會消費；模型透過 OpenAI 相容 API 呼叫本機 LM Studio，以 structured output 回傳固定欄位。"
      },
      {
        "id": "secrets",
        "label": "密鑰（Connections）",
        "focus": [
          "frontend",
          "api",
          "connections",
          "worker",
          "external"
        ],
        "note": "密鑰以 Fernet 加密存放、寫入後不再回傳。步驟用 {{connections.<name>}} 引用，worker 執行時才解密代換，結果與錯誤存進 log 前會遮掉；python / shell 拿不到。"
      },
      {
        "id": "auth-and-limit",
        "label": "身份驗證與資源隔離",
        "focus": [
          "frontend",
          "api",
          "auth",
          "redis"
        ],
        "note": "所有端點都需要 JWT，依登入身份套用 Redis 滑動窗口限流；定義、run、task、排程、密鑰都只屬於建立者，別人的一律 404。/ws/tasks 用 ?token= 驗證，只推送自己的 task。"
      },
      {
        "id": "cron-scheduling",
        "label": "週期性排程",
        "focus": [
          "beat",
          "redis",
          "worker",
          "db",
          "external"
        ],
        "note": "Celery Beat 每 60 秒檢查到期的排程，依定義當下的內容建立新的 run——例如每小時抓 GitHub issue、交給 LLM 分級、推到 Discord 的那條流水線。"
      }
    ]
  },
